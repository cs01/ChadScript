{
  "name": "chadscript",
  "version": "2.0.0-alpha.0",
  "description": "TypeScript to native code compiler",
  "type": "module",
  "main": "dist/compiler.js",
  "bin": {
    "chad2": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/compiler.test.ts",
    "test:quick": "QUICK=1 node --import tsx --test tests/compiler.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@swc/core": "^1.15.0",
    "koffi": "^2.16.1",
    "tree-sitter-cli": "^0.26.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "author": "Chad Smith",
  "license": "MIT"
}
