{
  "name": "chadscript",
  "version": "0.1.0",
  "description": "AOT compiler for a principled, statically analyzable subset of TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "Chad Smith",
  "repository": {
    "type": "git",
    "url": "https://github.com/cs01/ChadScript.git"
  },
  "bin": {
    "chad": "bin/chad"
  },
  "scripts": {
    "chad": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit tests/reject.test.ts tests/admission-ice.test.ts tests/dod.test.ts",
    "test:slow": "bun test --timeout 900000 tests/slow",
    "test:all": "bun test --timeout 900000 tests/",
    "fuzz": "bun run scripts/fuzz.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:stress": "CHAD_GC_STRESS=1 bun test --timeout 1800000 tests/slow/differential.test.ts",
    "test:san": "CHAD_SAN=1 ASAN_OPTIONS=detect_leaks=0:detect_stack_use_after_return=0 bun test --timeout 120000 tests/"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
