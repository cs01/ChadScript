{
  "name": "chadscript",
  "version": "2.0.0-dev",
  "description": "AOT compiler for a principled, statically analyzable subset of TypeScript",
  "type": "module",
  "license": "MIT",
  "author": "Chad Smith",
  "repository": {
    "type": "git",
    "url": "https://github.com/cs01/ChadScript.git"
  },
  "bin": {
    "chad": "src/cli.ts"
  },
  "scripts": {
    "chad": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
