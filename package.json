{
  "name": "chadscript",
  "version": "0.1.0",
  "description": "A JavaScript to native code compiler using LLVM",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chad": "./dist/chad.js",
    "chadc": "./dist/index.js"
  },
  "scripts": {
    "compile": "tsx src/index.ts",
    "build": "tsc",
    "test": "node scripts/test.js",
    "test:fast": "npm run build && node --import tsx --test tests/smoke.test.ts",
    "test:full": "node scripts/test.js",
    "test:verbose": "node --import tsx --test --test-reporter=spec tests/**/*.test.ts",
    "cli-tests": "node --import tsx tools/run-cli-tests.ts",
    "check-progress": "node --import tsx scripts/check-progress.ts",
    "examples": "node scripts/run-examples.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm run test:fast"
  },
  "keywords": [
    "compiler",
    "llvm",
    "javascript",
    "native"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "date-fns": "^4.1.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2"
  }
}
