{
  "name": "chadscript",
  "version": "0.1.0",
  "description": "A JavaScript to native code compiler using LLVM",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chadscript": "./dist/index.js"
  },
  "scripts": {
    "compile": "tsx src/index.ts",
    "build": "tsc",
    "test": "node scripts/test.js",
    "test:verbose": "node --import tsx --test --test-reporter=spec tests/**/*.test.ts",
    "agent-loop": "node --import tsx scripts/agent-loop.ts",
    "cli-tests": "node --import tsx tools/run-cli-tests.ts",
    "http-tests": "node --import tsx tools/run-http-tests.ts",
    "check-progress": "node --import tsx scripts/check-progress.ts",
    "examples": "node scripts/run-examples.js"
  },
  "keywords": [
    "compiler",
    "llvm",
    "javascript",
    "native"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
