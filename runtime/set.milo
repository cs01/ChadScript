// Set runtime: the C-ABI entry points over the shared ordered table (ordered.milo) with no value
// buffer. Elements compare with SameValueZero and are uniform i64 slots.

from "./abi" import { CsArray }
from "./ordered" import { CsOrdered, ordNew, ordFind, ordPut, ordDelete, ordClear, ordSize, ordSnapshot }
from "./array" import { cs_array_len, cs_array_get }

@externalLinkage
pub fn cs_set_new(): *CsOrdered {
    return ordNew(false)
}

// Adding an element already present is a no-op that keeps its first insertion position.
@externalLinkage
pub fn cs_set_add(s: *CsOrdered, e: i64, kind: i32) {
    ordPut(s, e, 0, kind)
}

@externalLinkage
pub fn cs_set_has(s: *CsOrdered, e: i64, kind: i32): i32 {
    return if ordFind(s, e, kind) >= 0 { 1 } else { 0 }
}

@externalLinkage
pub fn cs_set_delete(s: *CsOrdered, e: i64, kind: i32): i32 {
    return ordDelete(s, e, kind)
}

@externalLinkage
pub fn cs_set_clear(s: *CsOrdered) {
    ordClear(s)
}

@externalLinkage
pub fn cs_set_size(s: *CsOrdered): i32 {
    return ordSize(s)
}

// values()/keys() for eager consumers: a fresh array of the element slots in insertion order.
@externalLinkage
pub fn cs_set_values(s: *CsOrdered): *CsArray {
    return ordSnapshot(s, false)
}

// `new Set(array)`: add each element of a uniform-slot array (dedup applied by ordPut).
@externalLinkage
pub fn cs_set_from_array(arr: *CsArray, kind: i32): *CsOrdered {
    let s = ordNew(false)
    let n = cs_array_len(arr)
    var i: i32 = 0
    while i < n {
        ordPut(s, cs_array_get(arr, i), 0, kind)
        i = i + 1
    }
    return s
}
