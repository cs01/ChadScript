// Operations on a Value word (the encoding in abi.milo) that JS defines for any value and that
// need no static type: strict equality. Everything whose answer depends on a member's static type
// (printing an array, its element type) is emitted by codegen instead (src/codegen/value-ops.ts).

from "./abi" import { CsString, VALUE_DOUBLE_OFFSET, TAG_STRING, f64FromBits }
from "./strings" import { cs_str_eq }
from "./stdio" import { writeErrLit }

fn isNumber(v: u64): bool {
    return v >= VALUE_DOUBLE_OFFSET
}

// A pointer word (not a number, not one of the four immediates) carrying the string tag.
fn isString(v: u64): bool {
    return v < VALUE_DOUBLE_OFFSET && v > 3 && (v & 7) == TAG_STRING
}

fn numberOf(v: u64): f64 {
    return f64FromBits(v - VALUE_DOUBLE_OFFSET)
}

// `a === b` on two Values. Numbers compare as doubles (so NaN !== NaN and 0 === -0, which the bit
// patterns alone would get wrong: NaN is canonicalized to one pattern and -0 has its own); strings
// compare by content, because two equal strings are usually two allocations; everything else
// (undefined, null, booleans, objects, arrays, functions) is identity, which is the word itself.
@externalLinkage
pub fn cs_value_strict_eq(a: u64, b: u64): i32 {
    if isNumber(a) && isNumber(b) {
        if numberOf(a) == numberOf(b) {
            return 1
        }
        return 0
    }
    if isString(a) && isString(b) {
        unsafe {
            return cs_str_eq((a - (a & 7)) as *CsString, (b - (b & 7)) as *CsString)
        }
    }
    if a == b {
        return 1
    }
    return 0
}

// SameValueZero (`includes`, Map/Set keys): strict equality, except that NaN equals NaN. NaN is
// canonicalized before boxing, so two NaN words are the same bits.
@externalLinkage
pub fn cs_value_same_zero(a: u64, b: u64): i32 {
    if a == b {
        return 1
    }
    return cs_value_strict_eq(a, b)
}

// Generated code met a Value whose tag is not a member of the union the compiler proved it holds.
// Only a TypeScript soundness hole the validator missed can get here, so stop loudly.
@externalLinkage
pub fn cs_value_mismatch() {
    writeErrLit("chadscript: internal error: a value's run-time kind is not in its declared union\n")
    exit(70)
}
