// Number.prototype.toFixed (ECMAScript 21.1.3.3). The spec picks the n whose n / 10^f is closest
// to the EXACT binary value of x, ties to the larger n. printf("%.*f", f) rounds exact ties
// half-even ((2.5).toFixed(0) would print "2", JS says "3"), so it cannot be used at precision f.
// Instead print the full exact decimal expansion (every double has one of at most 1074 fractional
// digits, and both glibc and Apple libc print it exactly) and round that string half-up here.
// Rounding the exact expansion is exact: the first dropped digit >= 5 means the remainder is >= a
// half unit, which is "round up" both for a tie and for anything above it.

from "./abi" import { CsString, isNan, isFinite }
from "./libc" import { snprintf, trunc }
from "./csstring" import { cs_str_from, strLit }
from "./strings" import { cs_num_to_string }
from "./errors" import { throwKind, ERR_RANGE }

@externalLinkage
pub fn cs_num_to_fixed(x0: f64, digits: f64): *CsString {
    // ToIntegerOrInfinity(digits): NaN -> 0, else truncate. The range check precedes the NaN /
    // Infinity / 1e21 early returns, so (NaN).toFixed(101) still throws.
    let fd = if isNan(digits) { 0.0 } else { trunc(digits) }
    if !(fd >= 0.0 && fd <= 100.0) {
        throwKind(ERR_RANGE, strLit("toFixed() digits argument must be between 0 and 100"))
    }
    let f = fd as i64
    if !isFinite(x0) {
        return cs_num_to_string(x0)
    }
    // -0 is not < 0, so it gets no sign, as the spec says; it is mapped to +0 too, because printf
    // would spell it "-0.000...".
    let negative = x0 < 0.0
    let x = if negative { 0.0 - x0 } else if x0 == 0.0 { 0.0 } else { x0 }
    if x >= 1e21 {
        return cs_num_to_string(x0)
    }

    // x < 1e21 has at most 21 integer digits; 1100 fractional digits cover the exact expansion.
    var buf: [u8; 1200] = [0; 1200]
    unsafe {
        snprintf(buf.addrOf() as *u8, 1200, "%.*f", 1100 as i32, x)
    }
    var point: i64 = 0
    while buf[point] != '.' {
        point = point + 1
    }

    // out = optional '-', a possible carry digit, the integer digits, then '.' + f digits.
    var out: [u8; 1300] = [0; 1300]
    var o: i64 = 0
    if negative {
        out[o] = '-'
        o = o + 1
    }
    let start = o
    // Reserve a slot for a carry out of the leading digit; dropped below if unused.
    out[o] = '0'
    o = o + 1
    var i: i64 = 0
    while i < point {
        out[o] = buf[i]
        o = o + 1
        i = i + 1
    }
    if f > 0 {
        out[o] = '.'
        o = o + 1
        var k: i64 = 0
        while k < f {
            out[o] = buf[point + 1 + k]
            o = o + 1
            k = k + 1
        }
    }
    if buf[point + 1 + f] >= '5' {
        var j = o - 1
        while true {
            if out[j] == '.' {
                j = j - 1
            } else if out[j] == '9' {
                out[j] = '0'
                j = j - 1
            } else {
                out[j] = out[j] + 1
                break
            }
        }
    }
    unsafe {
        if out[start] == '0' {
            // No carry reached the reserved slot: shift the rest left over it.
            var m = start
            while m + 1 < o {
                out[m] = out[m + 1]
                m = m + 1
            }
            o = o - 1
        }
        return cs_str_from(out.addrOf() as *u8, o)
    }
}
