// libc and libm entry points the runtime calls, declared once. Milo `extern fn` declarations are
// program-wide rather than file-scoped (a second declaration of the same C name in another file
// silently replaces the first), so every module imports from here instead of redeclaring.
// A `FILE *` is carried as `*u8`: the runtime never looks inside one.

pub extern fn strtod(s: *u8, end: **u8): f64
pub extern fn snprintf(buf: *u8, n: i64, fmt: *u8, ...): i32
pub extern fn strlen(s: *u8): i64

pub extern fn floor(x: f64): f64
pub extern fn sqrt(x: f64): f64
pub extern fn trunc(x: f64): f64
pub extern fn fmod(x: f64, y: f64): f64
pub extern fn nextafter(x: f64, y: f64): f64

pub extern fn fopen(path: *u8, mode: *u8): *u8
pub extern fn fclose(f: *u8): i32
pub extern fn fseek(f: *u8, off: i64, whence: i32): i32
pub extern fn ftell(f: *u8): i64
pub extern fn rewind(f: *u8)
pub extern fn fread(p: *u8, size: i64, n: i64, f: *u8): i64
pub extern fn fwrite(p: *u8, size: i64, n: i64, f: *u8): i64
pub extern fn access(path: *u8, mode: i32): i32
pub extern fn unlink(path: *u8): i32
pub extern fn getcwd(buf: *u8, size: i64): *u8
pub extern fn getpid(): i32

// Memory the collector manages for itself (runtime/gc.milo): heap chunks, its side tables, fiber
// stacks. None of it is GC memory.
pub extern fn malloc(n: i64): *u8
pub extern fn calloc(n: i64, size: i64): *u8
pub extern fn realloc(p: *u8, n: i64): *u8
pub extern fn free(p: *u8)
pub extern fn posix_memalign(out: **u8, align: i64, size: i64): i32
pub extern fn memset(p: *u8, c: i32, n: i64): *u8
pub extern fn qsort(base: *u8, n: i64, size: i64, cmp: (*u8, *u8) => i32)
pub extern fn getenv(name: *u8): *u8
pub extern fn atoi(s: *u8): i32
pub extern fn abort()
// Called only to spill callee-saved registers into a buffer the stack scan covers; never longjmp'd
// to, so its returns-twice nature does not matter.
pub extern fn _setjmp(buf: *u8): i32
