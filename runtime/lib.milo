// The runtime's single Milo compilation unit. Every module is imported here so the driver
// compiles them into ONE object (src/driver/build.ts): Milo-internal helpers are then defined
// once instead of once per module object. An `@externalLinkage` fn is emitted with its C symbol
// whether or not anything here names it; the imports only pull each module into the build.

from "./csstring" import { cs_str_mk }
from "./path" import { cs_path_normalize }
from "./math" import { cs_math_round }
from "./time" import { cs_date_now }
from "./gc" import { cs_gc_alloc }
from "./array" import { cs_array_new }
from "./argv" import { cs_argv_slice2 }
from "./number" import { cs_to_int32 }
from "./number-c" import { cs_num_to_str }
from "./strings" import { cs_str_concat }
from "./string-methods" import { cs_str_len }
from "./map" import { cs_map_new }
from "./set" import { cs_set_new }
from "./json" import { cs_json_num }
from "./json-parse" import { cs_json_parse }
