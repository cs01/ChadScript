from "./array" import { cs_array_new }
from "./argv" import { cs_argv_slice2 }
from "./number" import { cs_to_int32 }
from "./strings" import { cs_str_concat }
from "./string-methods" import { cs_str_len }
from "./map" import { cs_map_new }
from "./set" import { cs_set_new }
from "./ordered" import { cs_ord_iter_next }
from "./json" import { cs_json_num }
from "./json-parse" import { cs_json_parse }
from "./fs" import { cs_fs_read_file }
from "./timer" import { cs_set_timeout }
from "./print" import { cs_print_f64 }
from "./inspect" import { cs_insp_finish }
from "./format" import { cs_console_format }
from "./async" import { cs_run_event_loop }
from "./fs-promises" import { cs_fsp_read_file }
