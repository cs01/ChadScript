// Exceptions via setjmp/longjmp. A GC'd language needs no stack unwinding for cleanup (Boehm
// reclaims memory), so a stack of handler buffers is enough: `try` allocates a handler, pushes it
// and calls `_setjmp` on it DIRECTLY from generated IR (setjmp returns twice, so it can never sit
// behind a wrapper call); `throw` longjmps to the top handler, unwinding any number of frames.
//
// longjmp skips Milo frames without running drops. Nothing in the runtime owns a droppable value
// across a call that can throw (locals are raw pointers, scalars and static literals), so nothing
// leaks.

from "./abi" import { CsString, byteAt, memcpy }
from "./csstring" import { cs_str_mk, cs_str_from, strLit }
from "./stdio" import { writeErr, writeErrLit }
from "./async" import { fiberUncaught }
from "./gc" import { gcAllocAtomic, gcAllocConservative, gcAllocStruct, gcAllocValues }

extern fn _longjmp(buf: *u8, v: i32)

// A thrown value, in GC memory. `isError` is the error class: 0 for a thrown string (`throw "s"`),
// else one of the ERR_* kinds below, which `String(e)`, `e.name` and `instanceof` need. Only
// string-messaged throws are in the subset.
pub extern struct CsThrown {
    isError: i32,
    message: *CsString,
}

// The builtin error classes (src/lower/errors.ts keeps the same numbering). Every one is an Error,
// so `instanceof Error` is any nonzero kind.
pub let ERR_ERROR: i32 = 1
pub let ERR_TYPE: i32 = 2
pub let ERR_RANGE: i32 = 3
pub let ERR_SYNTAX: i32 = 4

// Both constructors COPY the message rather than retaining the caller's pointer. Retaining it made a
// stack CsString in any C caller a dangling read at catch time, and that bug class is invisible to
// AddressSanitizer (the throw escapes by longjmp and ASan unpoisons the abandoned frame), so the
// API must not permit it. Throws are exceptional, so the copy is free in practice.
fn newThrown(isError: i32, message: *CsString): *CsThrown {
    unsafe {
        let t = gcAllocStruct(16, 0b10) as *CsThrown
        t.isError = isError
        t.message = cs_str_from(message.data, message.len)
        return t
    }
}

@externalLinkage
pub fn cs_new_error(message: *CsString): *CsThrown {
    return newThrown(ERR_ERROR, message)
}

// `new TypeError(m)` etc.: `kind` is one of the ERR_* kinds.
@externalLinkage
pub fn cs_new_error_kind(kind: i32, message: *CsString): *CsThrown {
    return newThrown(kind, message)
}

@externalLinkage
pub fn cs_new_thrown_str(s: *CsString): *CsThrown {
    return newThrown(0, s)
}

@externalLinkage
pub fn cs_thrown_is_error(t: *CsThrown): i32 {
    unsafe {
        return t.isError
    }
}

// `e instanceof <kind>`: every error class is an Error; the others match only themselves.
@externalLinkage
pub fn cs_thrown_is_kind(t: *CsThrown, kind: i32): i32 {
    unsafe {
        if kind == ERR_ERROR && t.isError != 0 {
            return 1
        }
        if t.isError == kind {
            return 1
        }
        return 0
    }
}

@externalLinkage
pub fn cs_thrown_message(t: *CsThrown): *CsString {
    unsafe {
        return t.message
    }
}

fn kindName(kind: i32): *CsString {
    if kind == ERR_TYPE {
        return strLit("TypeError")
    }
    if kind == ERR_RANGE {
        return strLit("RangeError")
    }
    if kind == ERR_SYNTAX {
        return strLit("SyntaxError")
    }
    return strLit("Error")
}

// `e.name`.
@externalLinkage
pub fn cs_thrown_name(t: *CsThrown): *CsString {
    unsafe {
        return kindName(t.isError)
    }
}

// `String(e)`: an Error stringifies as "<name>: <message>", or just "<name>" when the message is
// empty (Error.prototype.toString); a thrown string as itself.
@externalLinkage
pub fn cs_thrown_to_string(t: *CsThrown): *CsString {
    unsafe {
        let m = t.message
        if t.isError == 0 {
            return cs_str_from(m.data, m.len)
        }
        let name = kindName(t.isError)
        if m.len == 0 {
            return name
        }
        let n = name.len + 2
        let r = gcAllocAtomic(n + m.len)
        memcpyAt(r, 0, name.data, name.len)
        memcpyAt(r, name.len, ": ".cstr(), 2)
        memcpyAt(r, n, m.data, m.len)
        return cs_str_mk(r, n + m.len)
    }
}

fn memcpyLit(dst: *u8, s: &string) {
    unsafe {
        memcpy(dst, s.cstr(), s.len)
    }
}

fn memcpyAt(dst: *u8, off: i64, src: *u8, n: i64) {
    unsafe {
        memcpy(byteAt(dst, off), src, n)
    }
}

// A try handler: the jmp_buf, then the value thrown to it. The buffer comes FIRST so a handler
// pointer is directly the jmp_buf generated IR passes to _setjmp. jmp_buf's size is platform
// specific (192 bytes on macOS arm64, 200 on Linux x86-64, 312 on Linux arm64); residue.c
// static-asserts it fits in JMPBUF_BYTES. The thrown value lives in the handler, not a global, so
// exception state is local to the handler chain (and so to the fiber that owns the chain).
pub let JMPBUF_BYTES: i64 = 512

fn thrownSlot(h: *u8): **CsThrown {
    unsafe {
        return (h as i64 + JMPBUF_BYTES) as **CsThrown
    }
}

// The active handler stack: a growable GC array of handler pointers plus a count. It is SWAPPABLE
// (handlerCtxGet/Set) so each async fiber runs with its OWN stack: the async runtime installs a
// fiber's stack around every resume, so concurrent try/catch blocks suspended across `await` never
// corrupt each other's handler indices. Null/0/0 is a valid empty stack.
var gHandlers: **u8 = 0 as **u8
var gHandlerN: i32 = 0
var gHandlerCap: i32 = 0

pub extern struct HandlerCtx {
    stack: **u8,
    n: i32,
    cap: i32,
}

pub fn handlerCtxGet(): HandlerCtx {
    return HandlerCtx { stack: gHandlers, n: gHandlerN, cap: gHandlerCap }
}

pub fn handlerCtxSet(c: HandlerCtx) {
    cs_handler_ctx_set(c.stack, c.n, c.cap)
}

// @externalLinkage only for its exemption from Milo's pointer-parameter store rule: the stack is GC
// memory, not a buffer the caller owns, so keeping it in a global past the call is correct.
@externalLinkage
pub fn cs_handler_ctx_set(stack: **u8, n: i32, cap: i32) {
    gHandlers = stack
    gHandlerN = n
    gHandlerCap = cap
}

fn handlerSlot(i: i32): **u8 {
    unsafe {
        return (gHandlers as i64 + i as i64 * 8) as **u8
    }
}

// Allocate a handler for a `try` (GC memory; generated IR calls _setjmp on it directly).
@externalLinkage
pub fn cs_handler_alloc(): *u8 {
    unsafe {
        return gcAllocConservative(JMPBUF_BYTES + 8)
    }
}

@externalLinkage
pub fn cs_push_handler(h: *u8) {
    unsafe {
        if gHandlerN == gHandlerCap {
            let nc: i32 = if gHandlerCap > 0 { gHandlerCap * 2 } else { 16 }
            let nb = gcAllocValues(nc as i64 * 8) as **u8
            var i: i32 = 0
            while i < gHandlerN {
                *((nb as i64 + i as i64 * 8) as **u8) = *handlerSlot(i)
                i = i + 1
            }
            gHandlers = nb
            gHandlerCap = nc
        }
        *handlerSlot(gHandlerN) = h
    }
    gHandlerN = gHandlerN + 1
}

@externalLinkage
pub fn cs_pop_handler() {
    if gHandlerN > 0 {
        gHandlerN = gHandlerN - 1
    }
}

// Structured-completion support: a try records the handler depth on entry, and its cleanup path
// restores to that depth on ANY exit (normal, return, throw), so the pop count is uniform whichever
// exit is taken. Restore only ever pops.
@externalLinkage
pub fn cs_handler_count(): i32 {
    return gHandlerN
}

@externalLinkage
pub fn cs_handler_restore(n: i32) {
    if gHandlerN > n {
        gHandlerN = n
    }
}

// The value thrown to a handler (read by a catch binding, and by a finally that re-raises).
@externalLinkage
pub fn cs_handler_thrown(h: *u8): *CsThrown {
    unsafe {
        return *thrownSlot(h)
    }
}

// throw: unwind to the innermost handler, stashing the value IN that handler. With no handler, a
// throw inside an async fiber rejects that fiber's result promise (fiberUncaught does not return);
// anywhere else it terminates the process with exit code 1, as Node does on an uncaught exception
// (the harness compares stdout + exit code, so the stderr text is best-effort).
@externalLinkage
pub fn cs_throw(value: *CsThrown) {
    if gHandlerN > 0 {
        gHandlerN = gHandlerN - 1
        unsafe {
            let h = *handlerSlot(gHandlerN)
            *thrownSlot(h) = value
            _longjmp(h, 1)
        }
    }
    fiberUncaught(value)
    unsafe {
        if value as i64 != 0 && value.message as i64 != 0 {
            let text = cs_thrown_to_string(value)
            writeErr(text.data, text.len)
            writeErrLit("\n")
        } else {
            writeErrLit("Error\n")
        }
    }
    exit(1)
}

// Throw `Error(msg)` from runtime code. Does not return.
pub fn throwErrorLit(msg: &string) {
    throwError(strLit(msg))
}

pub fn throwError(msg: *CsString) {
    cs_throw(cs_new_error(msg))
}

pub fn throwKind(kind: i32, msg: *CsString) {
    cs_throw(newThrown(kind, msg))
}
