// JSON.stringify primitives. The recursive structure walk is emitted by codegen
// (src/codegen/json.ts); this provides the two leaf conversions that differ from ordinary
// number/string formatting: a JSON number (non-finite -> the literal `null`) and a JSON string
// (double quoted, with the JSON escape set: `\uXXXX` for control chars, not util.inspect's `\xHH`).

from "./abi" import { CsString, GC_malloc, isFinite }
from "./csstring" import { cs_str_mk, strLit }
from "./strings" import { cs_num_to_string }

// NaN and the infinities are not representable in JSON, so JSON.stringify emits `null`.
@externalLinkage
pub fn cs_json_num(d: f64): *CsString {
    if !isFinite(d) {
        return strLit("null")
    }
    return cs_num_to_string(d)
}

fn hexLower(d: i64): u8 {
    let chars = "0123456789abcdef"
    return chars[d]
}

// A string as a JSON string literal, escaped per RFC 8259: `"` and `\` backslash-escaped, the five
// named control escapes (\b \t \n \f \r), and any other control byte (< 0x20) as \u00XX. Bytes
// >= 0x20 (including UTF-8 continuation bytes) pass through unchanged (ASCII-exact; the unicode
// decision is Phase 4).
@externalLinkage
pub fn cs_json_str(s: *CsString): *CsString {
    unsafe {
        let d = s.data
        let n = s.len
        // Worst case each byte becomes \u00XX (6 bytes), plus the two quotes.
        let r = GC_malloc(n * 6 + 2)
        var o: i64 = 0
        r[o] = '"'
        o = o + 1
        var i: i64 = 0
        while i < n {
            let c = d[i]
            i = i + 1
            var named: u8 = 0
            if c == '"' || c == '\\' {
                r[o] = '\\'
                r[o + 1] = c
                o = o + 2
                continue
            } else if c == 8 {
                named = 'b'
            } else if c == '\t' {
                named = 't'
            } else if c == '\n' {
                named = 'n'
            } else if c == 12 {
                named = 'f'
            } else if c == '\r' {
                named = 'r'
            }
            if named != 0 {
                r[o] = '\\'
                r[o + 1] = named
                o = o + 2
            } else if c < 32 {
                r[o] = '\\'
                r[o + 1] = 'u'
                r[o + 2] = '0'
                r[o + 3] = '0'
                r[o + 4] = hexLower((c >> 4) as i64)
                r[o + 5] = hexLower((c & 15) as i64)
                o = o + 6
            } else {
                r[o] = c
                o = o + 1
            }
        }
        r[o] = '"'
        o = o + 1
        return cs_str_mk(r, o)
    }
}
