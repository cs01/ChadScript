// console.log's util.format pass, ported from Node's lib/internal/util/inspect.js
// formatWithOptionsInternal (v25.3.0). When the first argument is a string and more follow, its
// %s %d %i %f %j %o %O %c directives each consume the next argument and %% is a literal percent;
// whatever is left is appended, space-separated.
//
// Only the substitution loop lives here. How one argument turns into text under one directive
// depends on its static type (an array's element type, an object's shape), so codegen emits a
// per-call-site `thunk` (src/codegen/console-format.ts) that answers "the text of argument `idx`
// under directive `dir`" (dir is the directive letter, or 0 for an appended argument).

from "./abi" import { CsString, CsArray, byteAt }
from "./inspect" import { Sb, sbNew, sbBytes, sbByte, sbStr, sbDone, slen, sbyte }

fn sbSlice(out: *Sb, s: *CsString, from: i64, to: i64) {
    unsafe {
        sbBytes(out, byteAt(s.data, from), to - from)
    }
}

fn isDirective(c: u8): bool {
    return c == 's' || c == 'j' || c == 'd' || c == 'O' || c == 'o' || c == 'i' || c == 'f' || c == 'c'
}

// `firstIsString` is 0 when the first argument is not a string at run time (a union), in which
// case nothing is substituted and every argument, the first included, is appended.
@externalLinkage
pub fn cs_console_format(firstIsString: i32, first: *CsString, nargs: i32, thunk: extern (*CsArray, i32, i32) => *CsString, env: *CsArray): *CsString {
    let out = sbNew()
    var a: i32 = 0
    var join = false
    if firstIsString != 0 {
        let n = slen(first)
        var lastPos: i64 = 0
        var i: i64 = 0
        while i < n - 1 {
            if sbyte(first, i) == '%' {
                i = i + 1
                let c = sbyte(first, i)
                if a + 1 != nargs {
                    if isDirective(c) {
                        a = a + 1
                        if lastPos != i - 1 {
                            sbSlice(out, first, lastPos, i - 1)
                        }
                        // %c consumes its argument (a CSS string in browsers) and prints nothing.
                        if c != 'c' {
                            sbStr(out, thunk(env, a, c as i32))
                        }
                        lastPos = i + 1
                    } else if c == '%' {
                        sbSlice(out, first, lastPos, i)
                        lastPos = i + 1
                    }
                } else if c == '%' {
                    sbSlice(out, first, lastPos, i)
                    lastPos = i + 1
                }
            }
            i = i + 1
        }
        if lastPos != 0 {
            a = a + 1
            join = true
            if lastPos < n {
                sbSlice(out, first, lastPos, n)
            }
        }
    }
    while a < nargs {
        if join {
            sbByte(out, ' ')
        }
        if a == 0 && firstIsString != 0 {
            sbStr(out, first)
        } else {
            sbStr(out, thunk(env, a, 0))
        }
        join = true
        a = a + 1
    }
    return sbDone(out)
}
