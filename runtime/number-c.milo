// Transitional C entry points into number.milo for the C callers not yet ported (strings.c,
// runtime.c). Deleted once they are Milo.

from "./number" import { numToStr, numToRadix }

// Writes the NUL-terminated JS string form of x into `out` (at least 32 bytes).
@externalLinkage
pub fn cs_num_to_str(x: f64, out: *u8) {
    let n = numToStr(x, out)
    unsafe {
        out[n] = 0
    }
}

// NUL-terminated (numToRadix's GC buffer is zeroed one byte past the digits).
@externalLinkage
pub fn cs_num_to_radix(value: f64, radix: i32): *u8 {
    var n: i64 = 0
    return numToRadix(value, radix as i64, &mut n)
}
