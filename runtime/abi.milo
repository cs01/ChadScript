// The runtime's C-ABI seam: the layouts generated IR and the remaining C share with the Milo
// runtime, plus the libc and Boehm entry points it calls. Declared once here so every module
// agrees on them.
//
// GC rule: runtime memory comes from Boehm (GC_malloc / GC_malloc_atomic). Boehm scans only its
// own heap, thread stacks, static data and registered roots, so a GC pointer may live in a local,
// a global, or GC memory, and NEVER in Milo-owned heap memory (Vec, Heap, string buffers), which
// is malloc'd and invisible to the collector.

// A JS string: UTF-8 bytes, `len` is the only authority on length (no NUL terminator, and an
// embedded NUL is an ordinary byte). Generated IR passes it as an opaque `ptr`.
pub extern struct CsString {
    data: *u8,
    len: i64,
}

// A uniform-slot array: every element is one 8-byte slot (a double's bits, a pointer's bits, or
// 0/1). Generated IR only ever calls cs_array_* on it, never reads the fields.
pub extern struct CsArray {
    data: *i64,
    len: i32,
    cap: i32,
}

// An object's runtime shape: one immutable global per allocation layout, emitted by codegen
// (src/codegen/shapes.ts SHAPE_FIELDS, pinned to this struct by tests/unit/shape-abi.test.ts).
// Every object record is `[*CsShape, field 0 Value, field 1 Value, ...]`, class instances and
// literals alike. `names` holds `fieldCount` *CsString (codegen interns them, so equal names are
// usually the same pointer); `kinds` one KIND_* byte per field (the allocation's static kind);
// `className` is null for a literal. `methods` is the class's method table (vtable order) and
// `methodNames` the matching names, `methodCount` entries each. `inspect` (obj, depth) and `json`
// (obj, indent, depth) are the codegen-emitted functions that print / serialize this layout.
pub extern struct CsShape {
    fieldCount: i64,
    names: **CsString,
    kinds: *u8,
    className: *CsString,
    methodCount: i64,
    methods: **u8,
    methodNames: **CsString,
    inspect: *u8,
    json: *u8,
}

// The Value encoding (src/codegen/value.ts has the full rationale). One 64-bit word:
//   v >= VALUE_DOUBLE_OFFSET   a number, IEEE bits + 2^49 (NaN canonicalized first)
//   0 / 1 / 2 / 3              undefined / null / false / true
//   otherwise                  a pointer OR'ed with a 3-bit TAG_* in its low bits
pub let VALUE_UNDEFINED: u64 = 0
pub let VALUE_NULL: u64 = 1
pub let VALUE_FALSE: u64 = 2
pub let VALUE_TRUE: u64 = 3
pub let VALUE_DOUBLE_OFFSET: u64 = 0x0002000000000000
pub let TAG_OBJECT: u64 = 0
pub let TAG_STRING: u64 = 1
pub let TAG_ARRAY: u64 = 2
pub let TAG_FUNCTION: u64 = 3
pub let TAG_MAP: u64 = 4
pub let TAG_SET: u64 = 5
pub let TAG_PROMISE: u64 = 6
pub let TAG_OTHER: u64 = 7

// CsShape.kinds codes (src/codegen/shapes.ts KIND_CODE).
pub let KIND_NUMBER: u8 = 1
pub let KIND_STRING: u8 = 2
pub let KIND_BOOLEAN: u8 = 3
pub let KIND_NULL: u8 = 4
pub let KIND_UNDEFINED: u8 = 5
pub let KIND_ARRAY: u8 = 6
pub let KIND_OBJECT: u8 = 7
pub let KIND_OPTIONAL: u8 = 8
pub let KIND_FUNCTION: u8 = 9
pub let KIND_MAP: u8 = 10
pub let KIND_SET: u8 = 11
pub let KIND_UNKNOWN: u8 = 12
pub let KIND_PROMISE: u8 = 13
pub let KIND_OPAQUE: u8 = 14
pub let KIND_VALUE: u8 = 15

pub extern fn GC_malloc(n: i64): *u8
// Pointer-free memory: Boehm never scans it, so it is only for byte buffers.
pub extern fn GC_malloc_atomic(n: i64): *u8

pub extern fn memcpy(dst: *u8, src: *u8, n: i64): *u8
pub extern fn memmove(dst: *u8, src: *u8, n: i64): *u8
pub extern fn memcmp(a: *u8, b: *u8, n: i64): i32

// `p + i` for a raw byte pointer. Milo has no pointer arithmetic, so the offset goes through an
// integer; the result is only ever used inside the allocation `p` points into.
pub fn byteAt(p: *u8, i: i64): *u8 {
    unsafe {
        return (p as i64 + i) as *u8
    }
}

// The IEEE bit pattern of a double and back (LLVM folds the store/load into a bitcast).
pub fn f64Bits(v: f64): u64 {
    var bits: u64 = 0
    unsafe {
        bits = *(v.addrOf() as *u64)
    }
    return bits
}

pub fn f64FromBits(b: u64): f64 {
    var v: f64 = 0.0
    unsafe {
        v = *(b.addrOf() as *f64)
    }
    return v
}

pub fn isNan(x: f64): bool {
    return x != x
}

pub fn isFinite(x: f64): bool {
    return x - x == 0.0
}

pub fn signBit(x: f64): bool {
    return f64Bits(x) >> 63 == 1
}

pub let NEG_ZERO_BITS: u64 = 0x8000000000000000
