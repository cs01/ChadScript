// Map runtime: the C-ABI entry points over the shared ordered table (ordered.milo), which holds
// the insertion order, the hash index and live iteration. Keys compare with SameValueZero (see
// hashkey.milo). Keys and values are uniform i64 slots (the same boxing as arrays).

from "./abi" import { CsArray }
from "./ordered" import { CsOrdered, ordNew, ordFind, ordPut, ordDelete, ordClear, ordSize, ordSnapshot }
from "./nullable" import { undefinedMarker, boxSlot }

@externalLinkage
pub fn cs_map_new(): *CsOrdered {
    return ordNew(true)
}

@externalLinkage
pub fn cs_map_set(m: *CsOrdered, k: i64, v: i64, kind: i32) {
    ordPut(m, k, v, kind)
}

// get -> `value | undefined`: found gives a GC box holding the value slot; missing, the marker.
@externalLinkage
pub fn cs_map_get(m: *CsOrdered, k: i64, kind: i32): *u8 {
    let i = ordFind(m, k, kind)
    if i < 0 {
        return undefinedMarker()
    }
    unsafe {
        return boxSlot(m.vals[i as i64])
    }
}

@externalLinkage
pub fn cs_map_has(m: *CsOrdered, k: i64, kind: i32): i32 {
    return if ordFind(m, k, kind) >= 0 { 1 } else { 0 }
}

@externalLinkage
pub fn cs_map_delete(m: *CsOrdered, k: i64, kind: i32): i32 {
    return ordDelete(m, k, kind)
}

@externalLinkage
pub fn cs_map_clear(m: *CsOrdered) {
    ordClear(m)
}

@externalLinkage
pub fn cs_map_size(m: *CsOrdered): i32 {
    return ordSize(m)
}

// keys()/values() for eager consumers: a fresh array of the slots in insertion order. (A for...of
// loop iterates the table live instead, through cs_ord_iter_next.)
@externalLinkage
pub fn cs_map_keys(m: *CsOrdered): *CsArray {
    return ordSnapshot(m, false)
}

@externalLinkage
pub fn cs_map_values(m: *CsOrdered): *CsArray {
    return ordSnapshot(m, true)
}
