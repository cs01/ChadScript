// JSON.parse's runtime half: text -> a generic tagged tree. Codegen walks that tree against the
// STATIC target shape (see src/codegen/json-parse.ts), mirroring how stringify is type-directed,
// and the compiler never parses text. The one thing decided here is each object's record layout
// (cs_json_object), because Node orders an object's keys by the text.
//
// Strict RFC 8259, which is what Node accepts: no trailing commas, no comments, no single quotes,
// no leading `+`, no leading zeros, no NaN/Infinity literals. Duplicate object keys keep the LAST
// occurrence, as Node does.
//
// Non-ASCII is REFUSED rather than approximated. The charter locks strings to ASCII-exact, so a
// non-ASCII escape or raw high byte would produce a value the rest of the language does not promise
// to handle correctly. Throwing keeps the ASCII invariant true instead of documenting an exception.
//
// A parse error throws (longjmp) out of the middle of the recursion. Nothing here owns anything
// that needs a drop (every local is a raw pointer, a scalar or a literal), so skipping the frames
// leaks nothing.

from "./abi" import {
    CsString,
    CsShape,
    GC_malloc,
    GC_malloc_atomic,
    memcpy,
    byteAt,
    f64Bits,
    KIND_VALUE,
    VALUE_NULL,
    VALUE_TRUE,
    VALUE_FALSE,
    VALUE_DOUBLE_OFFSET,
    TAG_STRING,
    TAG_ARRAY,
}
from "./array" import { cs_array_new, cs_array_push }
from "./csstring" import { cs_str_mk, cs_str_from }
from "./strings" import { cs_str_eq }
from "./errors" import { throwErrorLit, throwError }
from "./libc" import { strtod }

let JSON_NULL: i32 = 0
let JSON_BOOL: i32 = 1
let JSON_NUMBER: i32 = 2
let JSON_STRING: i32 = 3
let JSON_ARRAY: i32 = 4
let JSON_OBJECT: i32 = 5

// GC memory; only the cs_json_* accessors below read it, so the layout is private to this file.
extern struct JsonValue {
    kind: i32,
    bval: i32,
    num: f64,
    str: *CsString,
    items: **JsonValue,
    count: i32,
    keys: **CsString,
    vals: **JsonValue,
    nfields: i32,
}

extern struct Parser {
    s: *u8,
    len: i64,
    i: i64,
}

// Throws; never returns. Callers still write a `return` after it only because the throw is an
// extern call the checker cannot see diverge.
fn fail(msg: &string) {
    throwErrorLit(msg)
}

fn jvNew(kind: i32): *JsonValue {
    unsafe {
        let v = GC_malloc(64) as *JsonValue
        v.kind = kind
        return v
    }
}

fn at(p: &Parser, i: i64): u8 {
    unsafe {
        return p.s[i]
    }
}

fn cur(p: &Parser): u8 {
    return at(p, p.i)
}

fn isDigit(c: u8): bool {
    return c >= '0' && c <= '9'
}

fn skipWs(p: &mut Parser) {
    while p.i < p.len {
        let c = cur(p)
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            p.i = p.i + 1
        } else {
            break
        }
    }
}

fn expect(p: &mut Parser, c: u8) {
    if p.i >= p.len || cur(p) != c {
        fail("JSON.parse: unexpected token")
    }
    p.i = p.i + 1
}

fn parseLiteral(p: &mut Parser, lit: &string) {
    let n = lit.len
    var ok = p.i + n <= p.len
    var k: i64 = 0
    while ok && k < n {
        if at(p, p.i + k) != lit[k] {
            ok = false
        }
        k = k + 1
    }
    if !ok {
        fail("JSON.parse: unexpected token")
    }
    p.i = p.i + n
}

// A growable pointer-free byte buffer for decoded string contents; lives on the stack, where Boehm
// sees `data`.
extern struct SBuf {
    data: *u8,
    len: i64,
    cap: i64,
}

fn sbufPush(b: &mut SBuf, c: u8) {
    unsafe {
        if b.len == b.cap {
            let cap = if b.cap > 0 { b.cap * 2 } else { 32 }
            let grown = GC_malloc_atomic(cap)
            if b.len > 0 {
                memcpy(grown, b.data, b.len)
            }
            b.data = grown
            b.cap = cap
        }
        b.data[b.len] = c
    }
    b.len = b.len + 1
}

fn sbufPushLit(b: &mut SBuf, s: &string) {
    var k: i64 = 0
    while k < s.len {
        sbufPush(&mut b, s[k])
        k = k + 1
    }
}

fn sbufPushStr(b: &mut SBuf, s: *CsString) {
    unsafe {
        var k: i64 = 0
        while k < s.len {
            sbufPush(&mut b, s.data[k])
            k = k + 1
        }
    }
}

fn hexDigit(c: u8): i64 {
    if c >= '0' && c <= '9' {
        return (c - '0') as i64
    }
    if c >= 'a' && c <= 'f' {
        return (c - 'a') as i64 + 10
    }
    if c >= 'A' && c <= 'F' {
        return (c - 'A') as i64 + 10
    }
    return -1
}

fn parseString(p: &mut Parser): *CsString {
    expect(&mut p, '"')
    var b = SBuf { data: 0 as *u8, len: 0, cap: 0 }
    while true {
        if p.i >= p.len {
            fail("JSON.parse: unterminated string")
        }
        let c = cur(p)
        if c == '"' {
            p.i = p.i + 1
            break
        }
        if c == '\\' {
            p.i = p.i + 1
            if p.i >= p.len {
                fail("JSON.parse: unterminated escape")
            }
            let e = cur(p)
            p.i = p.i + 1
            if e == '"' {
                sbufPush(&mut b, '"')
            } else if e == '\\' {
                sbufPush(&mut b, '\\')
            } else if e == '/' {
                sbufPush(&mut b, '/')
            } else if e == 'b' {
                sbufPush(&mut b, 8)
            } else if e == 'f' {
                sbufPush(&mut b, 12)
            } else if e == 'n' {
                sbufPush(&mut b, '\n')
            } else if e == 'r' {
                sbufPush(&mut b, '\r')
            } else if e == 't' {
                sbufPush(&mut b, '\t')
            } else if e == 'u' {
                if p.i + 4 > p.len {
                    fail("JSON.parse: truncated \\u escape")
                }
                var cp: i64 = 0
                var k: i64 = 0
                while k < 4 {
                    let d = hexDigit(at(p, p.i + k))
                    if d < 0 {
                        fail("JSON.parse: invalid \\u escape")
                    }
                    cp = cp * 16 + d
                    k = k + 1
                }
                p.i = p.i + 4
                // ASCII-exact: a non-ASCII code point has no representation this language promises.
                if cp > 127 {
                    fail("JSON.parse: non-ASCII characters are not supported")
                }
                sbufPush(&mut b, cp as u8)
            } else {
                fail("JSON.parse: invalid escape")
            }
            continue
        }
        if c < 32 {
            fail("JSON.parse: control character in string")
        }
        if c > 127 {
            fail("JSON.parse: non-ASCII characters are not supported")
        }
        sbufPush(&mut b, c)
        p.i = p.i + 1
    }
    return cs_str_from(b.data, b.len)
}

fn skipDigits(p: &mut Parser) {
    while p.i < p.len && isDigit(cur(p)) {
        p.i = p.i + 1
    }
}

fn parseNumber(p: &mut Parser): *JsonValue {
    let start = p.i
    if p.i < p.len && cur(p) == '-' {
        p.i = p.i + 1
    }
    // Integer part: a single 0, or a nonzero digit followed by digits. Leading zeros are invalid.
    if p.i >= p.len {
        fail("JSON.parse: unexpected end of number")
    }
    let first = cur(p)
    if first == '0' {
        p.i = p.i + 1
    } else if first >= '1' && first <= '9' {
        skipDigits(&mut p)
    } else {
        fail("JSON.parse: unexpected token")
    }
    if p.i < p.len && cur(p) == '.' {
        p.i = p.i + 1
        if p.i >= p.len || !isDigit(cur(p)) {
            fail("JSON.parse: malformed number")
        }
        skipDigits(&mut p)
    }
    if p.i < p.len && (cur(p) == 'e' || cur(p) == 'E') {
        p.i = p.i + 1
        if p.i < p.len && (cur(p) == '+' || cur(p) == '-') {
            p.i = p.i + 1
        }
        if p.i >= p.len || !isDigit(cur(p)) {
            fail("JSON.parse: malformed exponent")
        }
        skipDigits(&mut p)
    }
    // strtod needs a NUL-terminated buffer; the span is already validated as a JSON number, whose
    // grammar is a strict subset of what strtod accepts, so it consumes exactly this span.
    let n = p.i - start
    let v = jvNew(JSON_NUMBER)
    unsafe {
        let buf = GC_malloc_atomic(n + 1)
        memcpy(buf, byteAt(p.s, start), n)
        buf[n] = 0
        v.num = strtod(buf, 0 as **u8)
    }
    return v
}

fn ptrSlot(base: **u8, i: i64): **u8 {
    unsafe {
        return (base as i64 + i * 8) as **u8
    }
}

// Copy `n` pointer slots into a fresh GC array of `cap` slots.
fn growSlots(old: **u8, n: i64, cap: i64): **u8 {
    unsafe {
        let grown = GC_malloc(cap * 8) as **u8
        if n > 0 {
            memcpy(grown as *u8, old as *u8, n * 8)
        }
        return grown
    }
}

fn parseArray(p: &mut Parser): *JsonValue {
    expect(&mut p, '[')
    let v = jvNew(JSON_ARRAY)
    var cap: i64 = 8
    var items = growSlots(0 as **u8, 0, cap)
    var count: i64 = 0
    skipWs(&mut p)
    if p.i < p.len && cur(p) == ']' {
        p.i = p.i + 1
    } else {
        while true {
            if count == cap {
                cap = cap * 2
                items = growSlots(items, count, cap)
            }
            let item = parseValue(&mut p)
            unsafe {
                *ptrSlot(items, count) = item as *u8
            }
            count = count + 1
            skipWs(&mut p)
            if p.i < p.len && cur(p) == ',' {
                p.i = p.i + 1
                skipWs(&mut p)
                continue
            }
            expect(&mut p, ']')
            break
        }
    }
    unsafe {
        v.items = items as **JsonValue
        v.count = count as i32
    }
    return v
}

fn parseObject(p: &mut Parser): *JsonValue {
    expect(&mut p, '{')
    let v = jvNew(JSON_OBJECT)
    var cap: i64 = 8
    var keys = growSlots(0 as **u8, 0, cap)
    var vals = growSlots(0 as **u8, 0, cap)
    var nfields: i64 = 0
    skipWs(&mut p)
    if p.i < p.len && cur(p) == '}' {
        p.i = p.i + 1
    } else {
        while true {
            skipWs(&mut p)
            let key = parseString(&mut p)
            skipWs(&mut p)
            expect(&mut p, ':')
            skipWs(&mut p)
            let val = parseValue(&mut p)
            // Duplicate keys: the last occurrence wins, matching Node.
            var existing: i64 = -1
            var k: i64 = 0
            while k < nfields {
                unsafe {
                    if cs_str_eq((*ptrSlot(keys, k)) as *CsString, key) != 0 {
                        existing = k
                        break
                    }
                }
                k = k + 1
            }
            unsafe {
                if existing >= 0 {
                    *ptrSlot(vals, existing) = val as *u8
                } else {
                    if nfields == cap {
                        cap = cap * 2
                        keys = growSlots(keys, nfields, cap)
                        vals = growSlots(vals, nfields, cap)
                    }
                    *ptrSlot(keys, nfields) = key as *u8
                    *ptrSlot(vals, nfields) = val as *u8
                    nfields = nfields + 1
                }
            }
            skipWs(&mut p)
            if p.i < p.len && cur(p) == ',' {
                p.i = p.i + 1
                continue
            }
            expect(&mut p, '}')
            break
        }
    }
    unsafe {
        v.keys = keys as **CsString
        v.vals = vals as **JsonValue
        v.nfields = nfields as i32
    }
    return v
}

fn parseValue(p: &mut Parser): *JsonValue {
    skipWs(&mut p)
    if p.i >= p.len {
        fail("JSON.parse: unexpected end of input")
        return jvNew(JSON_NULL)
    }
    let c = cur(p)
    if c == '{' {
        return parseObject(&mut p)
    }
    if c == '[' {
        return parseArray(&mut p)
    }
    if c == '"' {
        let v = jvNew(JSON_STRING)
        let s = parseString(&mut p)
        unsafe {
            v.str = s
        }
        return v
    }
    if c == 't' {
        parseLiteral(&mut p, "true")
        let v = jvNew(JSON_BOOL)
        unsafe {
            v.bval = 1
        }
        return v
    }
    if c == 'f' {
        parseLiteral(&mut p, "false")
        let v = jvNew(JSON_BOOL)
        unsafe {
            v.bval = 0
        }
        return v
    }
    if c == 'n' {
        parseLiteral(&mut p, "null")
        return jvNew(JSON_NULL)
    }
    return parseNumber(&mut p)
}

@externalLinkage
pub fn cs_json_parse(text: *CsString): *JsonValue {
    var p = Parser { s: 0 as *u8, len: 0, i: 0 }
    unsafe {
        p.s = text.data
        p.len = text.len
    }
    let v = parseValue(&mut p)
    skipWs(&mut p)
    if p.i != p.len {
        fail("JSON.parse: unexpected trailing content")
    }
    return v
}

// Accessors. Codegen calls these after checking the kind, so a mismatch is the compiler's bug
// rather than the user's, except cs_json_expect_fail, which reports the USER's shape mismatch.
@externalLinkage
pub fn cs_json_kind(v: *JsonValue): i32 {
    unsafe {
        return v.kind
    }
}

@externalLinkage
pub fn cs_json_number_of(v: *JsonValue): f64 {
    unsafe {
        return v.num
    }
}

@externalLinkage
pub fn cs_json_bool_of(v: *JsonValue): i32 {
    unsafe {
        return v.bval
    }
}

@externalLinkage
pub fn cs_json_string_of(v: *JsonValue): *CsString {
    unsafe {
        return v.str
    }
}

@externalLinkage
pub fn cs_json_array_len(v: *JsonValue): i32 {
    unsafe {
        return v.count
    }
}

@externalLinkage
pub fn cs_json_array_get(v: *JsonValue, i: i32): *JsonValue {
    unsafe {
        return v.items[i as i64]
    }
}

// Field lookup by name; null when absent (codegen decides whether that is an error, since an
// optional field may legitimately be missing).
@externalLinkage
pub fn cs_json_field(v: *JsonValue, key: *CsString): *JsonValue {
    unsafe {
        if v.kind != JSON_OBJECT {
            return 0 as *JsonValue
        }
        var k: i64 = 0
        while k < v.nfields as i64 {
            if cs_str_eq(v.keys[k], key) != 0 {
                return v.vals[k]
            }
            k = k + 1
        }
        return 0 as *JsonValue
    }
}

// The shape-mismatch throw. `path` is the compile-time-known location in the target type (e.g.
// "value.items[]"), so the message names WHERE the JSON disagreed with T.
@externalLinkage
pub fn cs_json_expect_fail(path: *CsString, expected: *CsString) {
    var b = SBuf { data: 0 as *u8, len: 0, cap: 0 }
    sbufPushLit(&mut b, "JSON.parse: expected ")
    sbufPushStr(&mut b, expected)
    sbufPushLit(&mut b, " at ")
    sbufPushStr(&mut b, path)
    throwError(cs_str_mk(b.data, b.len))
}

// The shapes cs_json_object has made for one template, as a GC linked list whose head lives in a
// codegen-emitted zeroed global (`shape.N.jsoncache`); Boehm scans globals, so the list and every
// shape on it stay alive. Interning keeps one shape per distinct key order, which is what lets the
// inline caches at the program's field reads hit.
extern struct JsonShapeNode {
    next: *JsonShapeNode,
    shape: *CsShape,
}

// The template's field index for `key`, or -1 when the target type does not declare it.
fn templateIndex(template: *CsShape, key: *CsString): i64 {
    var i: i64 = 0
    unsafe {
        while i < template.fieldCount {
            if cs_str_eq(template.names[i], key) != 0 {
                return i
            }
            i = i + 1
        }
    }
    return -1
}

// Whether `shape` lays out the keys of this object: `order[k]` is the template field index of key k,
// or -1 for a key the type does not declare (named by `keys[k]`). Declared names are the template's
// own pointers, so pointer equality compares them; an undeclared name was copied from some earlier
// text, so it compares by content.
fn sameOrder(shape: *CsShape, template: *CsShape, order: *i64, keys: **CsString, n: i64): bool {
    unsafe {
        if shape.fieldCount != n {
            return false
        }
        var k: i64 = 0
        while k < n {
            if order[k] >= 0 {
                if shape.names[k] as i64 != template.names[order[k]] as i64 {
                    return false
                }
            } else {
                if shape.kinds[k] != KIND_VALUE || cs_str_eq(shape.names[k], keys[k]) == 0 {
                    return false
                }
            }
            k = k + 1
        }
    }
    return true
}

fn internShape(
    template: *CsShape,
    cache: **JsonShapeNode,
    order: *i64,
    keys: **CsString,
    n: i64,
): *CsShape {
    unsafe {
        var cur = *cache
        while cur as i64 != 0 {
            if sameOrder(cur.shape, template, order, keys, n) {
                return cur.shape
            }
            cur = cur.next
        }
        let names = GC_malloc(n * 8 + 8) as **CsString
        let kinds = GC_malloc_atomic(n + 1)
        var k: i64 = 0
        while k < n {
            if order[k] >= 0 {
                names[k] = template.names[order[k]]
                kinds[k] = template.kinds[order[k]]
            } else {
                names[k] = keys[k]
                kinds[k] = KIND_VALUE
            }
            k = k + 1
        }
        let shape = GC_malloc(72) as *CsShape
        shape.fieldCount = n
        shape.names = names
        shape.kinds = kinds
        shape.className = template.className
        shape.methodCount = template.methodCount
        shape.methods = template.methods
        shape.methodNames = template.methodNames
        shape.inspect = template.inspect
        shape.json = template.json
        let node = GC_malloc(16) as *JsonShapeNode
        node.next = *cache
        node.shape = shape
        *cache = node
        return shape
    }
}

// The Value word of a JSON value no type describes (an undeclared key's value, or anything inside
// one): the plain JSON kinds, with arrays of such words and objects laid out by the dynamic
// template, whose printers treat every field this same way (src/codegen/json-any.ts).
fn anyValue(v: *JsonValue, dyn: *CsShape, dynCache: **JsonShapeNode, path: *CsString): u64 {
    unsafe {
        if v.kind == JSON_NULL {
            return VALUE_NULL
        }
        if v.kind == JSON_BOOL {
            if v.bval != 0 {
                return VALUE_TRUE
            }
            return VALUE_FALSE
        }
        if v.kind == JSON_NUMBER {
            // JSON has no NaN, so no canonicalization is needed before the offset.
            return f64Bits(v.num) + VALUE_DOUBLE_OFFSET
        }
        if v.kind == JSON_STRING {
            return v.str as i64 as u64 | TAG_STRING
        }
        if v.kind == JSON_ARRAY {
            let arr = cs_array_new()
            var i: i64 = 0
            while i < v.count as i64 {
                cs_array_push(arr, anyValue(v.items[i], dyn, dynCache, path) as i64)
                i = i + 1
            }
            return arr as i64 as u64 | TAG_ARRAY
        }
        let rec = cs_json_object(v, dyn, dynCache, 0 as *u64, path, dyn, dynCache)
        return rec as i64 as u64
    }
}

// Build the record for a parsed JSON object whose declared fields codegen already validated into
// `vals` (template field order). The record holds the keys the TEXT has, in text order (the parser
// already folded duplicates: first position, last value), so it prints, serializes and lists keys
// like Node's object. A key the target type does not declare is kept too, as Node keeps it: its
// value becomes a plain Value word (anyValue), so printing, JSON.stringify and Object.keys show it,
// while the program cannot name it (tsc rejects the read). `dyn` is the dynamic template (no
// declared fields) that nested undeclared objects are laid out with.
@externalLinkage
pub fn cs_json_object(
    v: *JsonValue,
    template: *CsShape,
    cache: **JsonShapeNode,
    vals: *u64,
    path: *CsString,
    dyn: *CsShape,
    dynCache: **JsonShapeNode,
): *u64 {
    unsafe {
        let n = v.nfields as i64
        let order = GC_malloc_atomic(n * 8 + 8) as *i64
        var k: i64 = 0
        while k < n {
            order[k] = templateIndex(template, v.keys[k])
            k = k + 1
        }
        let shape = internShape(template, cache, order, v.keys, n)
        let rec = GC_malloc(n * 8 + 8) as *u64
        rec[0] = shape as i64 as u64
        k = 0
        while k < n {
            if order[k] >= 0 {
                rec[k + 1] = vals[order[k]]
            } else {
                rec[k + 1] = anyValue(v.vals[k], dyn, dynCache, path)
            }
            k = k + 1
        }
        return rec
    }
}
