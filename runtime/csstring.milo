// CsString constructors and NUL-safe byte search: the primitives every string helper builds on.
// Strings are {data,len} (see abi.milo); an embedded NUL is an ordinary byte here.

from "./abi" import { CsString, GC_malloc, memcpy, memcmp, byteAt }

// Wrap an already-stable buffer (a static literal, or GC memory the caller just filled) into a
// CsString header WITHOUT copying. The buffer must outlive the header; when it is GC memory, the
// returned (GC-allocated) header holds the only interior pointer that keeps it reachable.
@externalLinkage
pub fn cs_str_mk(data: *u8, len: i64): *CsString {
    unsafe {
        let s = GC_malloc(16) as *CsString
        s.data = data
        s.len = len
        return s
    }
}

// Copy `len` bytes into fresh GC memory and wrap them.
@externalLinkage
pub fn cs_str_from(data: *u8, len: i64): *CsString {
    unsafe {
        // GC_malloc(0) is legal, but a non-empty buffer keeps `data` a valid pointer always.
        let buf = GC_malloc(if len > 0 { len } else { 1 })
        if len > 0 {
            memcpy(buf, data, len)
        }
        return cs_str_mk(buf, len)
    }
}

// A CsString over a Milo string literal. Literals live in static read-only data, so wrapping
// without a copy is safe for the life of the program.
pub fn strLit(s: &string): *CsString {
    return cs_str_mk(s.cstr(), s.len)
}

// First index of needle in haystack at/after byte `from`, or -1. Empty needle: clamp(from, len).
// The NUL-safe replacement for strstr.
@externalLinkage
pub fn cs_mem_find(h: *u8, hlen: i64, n: *u8, nlen: i64, from: i64): i64 {
    if nlen == 0 {
        if from <= hlen {
            return from
        }
        return hlen
    }
    if nlen > hlen {
        return -1
    }
    var i = from
    while i + nlen <= hlen {
        unsafe {
            if memcmp(byteAt(h, i), n, nlen) == 0 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}
