# service settings
APP_NAME=corpus-service
APP_ENV = staging
PORT=3000
HOST="0.0.0.0"
BASE_URL=http://${HOST}:${PORT}/api
GREETING='Hello, $APP_NAME'   # single quotes: no interpolation
MULTI="line one\nline two"
export DEBUG=true
EMPTY=
