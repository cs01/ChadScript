# Dependencies
node_modules/
package-lock.json

# Build outputs
dist/
*.o
*.ll
src-js

# Test artifacts at root
test-*

# Executables (compiled binaries from examples and tests)
# Ignore all extensionless files (binaries) in examples/
examples/*
!examples/*.*
!examples/*/

# Ignore all binaries in tests/
tests/*
!tests/*.ts
!tests/*.js
!tests/*/

# Ignore all binaries in test fixtures
tests/fixtures/*
!tests/fixtures/*.js
!tests/fixtures/*.ts
!tests/fixtures/README.md
!tests/fixtures/*/

# TypeScript
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Logs
*.log
npm-debug.log*
.crush
